{
  "name": "dsh-desktop-bridge",
  "version": "0.5.0",
  "description": "Windows notifications for DSH: a bottom-right toast when a session needs your confirmation, finishes, or fails. One plugin, no companion process.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "test": "node test/contract.mjs && node test/host-apply.mjs && node test/runtime.mjs",
    "test:bundle": "node test/contract.mjs",
    "test:host": "node test/host-apply.mjs",
    "test:runtime": "node test/runtime.mjs",
    "check": "node scripts/check-bundle.mjs && node scripts/verify-profile.mjs",
    "check:profile": "node scripts/verify-profile.mjs",
    "register-aumid": "node scripts/register-aumid.mjs",
    "unregister-aumid": "node scripts/register-aumid.mjs --remove",
    "check-aumid": "node scripts/register-aumid.mjs --check"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.5": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/ingest.js",
    "lib/notifier.js",
    "lib/host/",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "notification",
    "toast",
    "windows"
  ],
  "license": "MIT"
}
